# TMI environment variables. Copy to .env and fill in real values, or paste into
# Vercel > Project > Settings > Environment Variables. NEVER commit real secrets.
# On Vercel these are already set; this file is a checklist / for other hosts.

# ── Required (app will not run without these) ─────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=        # service-account JSON (raw or base64). Database + storage.
JWT_SECRET=                      # signs admin / member / rep logins + TMI OS tenant logins

# ── TMI OS (client platform on os.tmitechai.com) ──────────────────────────────
# Uses ANTHROPIC_API_KEY (below) for the COO, worker output, and onboarding build.
CRON_SECRET=                     # protects the scheduled worker sweep (/api/os2-cron)
OS_SECRETS_KEY=                  # encrypts every stored connector credential (Stripe key, OAuth tokens).
                                 # 32-byte key as hex/base64/raw. STRONGLY recommended in production;
                                 # if unset it derives from JWT_SECRET, so rotating JWT_SECRET would
                                 # then orphan all encrypted connector secrets. Set it explicitly.
# Connector data feeds (set the ones clients will connect):
#   Stripe: clients paste their own restricted key in-app (no env var needed).
#   QuickBooks: OAuth (uses the app's registered client - see os2-oauth).
PLAID_CLIENT_ID=                 # bank cash-on-hand feed (optional)
PLAID_SECRET=
PLAID_ENV=                       # sandbox | development | production

# ── City Leads portal (field app) ────────────────────────────────────────────
DEEPGRAM_API_KEY=                # voice transcription (interaction recording, voice-to-lead)
ANTHROPIC_API_KEY=               # AI recaps, business-card scan, voice-to-lead
TWILIO_ACCOUNT_SID=              # daily rep reminder texts
TWILIO_AUTH_TOKEN=
# Web push for the field app (optional). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=                # push notifications (follow-up nudges, warm-lead alerts)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                   # mailto:you@tmitechai.com (contact for the push service)
# Google Maps key is embedded client-side in cityleads/index.html (not an env var).
# Firebase Storage bucket is hardcoded (tmitech-e264c.firebasestorage.app).

# ── Cold-email campaign / GTM ─────────────────────────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=           # default campaign
INSTANTLY_CAMPAIGN_ID_INDUSTRIAL=  # optional, if splitting by industry
INSTANTLY_CAMPAIGN_ID_SERVICE=     # optional
GTM_RUN_SECRET=                  # protects the daily send + manual-trigger endpoints
NEVERBOUNCE_API_KEY=             # email verification gate
RESEND_API_KEY=                  # transactional email

# ── Payments (only if you enable deposits / paid audits) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Optional integrations (set only the ones you use) ─────────────────────────
APIFY_API_TOKEN=                 # business scraping
APOLLO_API_KEY=                  # people enrichment
AHREFS_API_KEY=                  # SEO data
OPENAI_API_KEY=
BRAVE_API_KEY=
FINDYMAIL_API_KEY=
DROPCONTACT_API_KEY=
QSTASH_TOKEN=                    # scheduled/queued jobs (Upstash)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CAL_WEBHOOK_SECRET=              # Cal.com booking webhook
INSTANTLY_WEBHOOK_SECRET=        # inbound reply handling
# Social publishing (optional):
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Meta ads / CAPI (optional):
META_CAPI_ACCESS_TOKEN=
META_DATASET_ID=
META_AD_ACCOUNT_ID=
