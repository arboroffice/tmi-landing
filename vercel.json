{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/audit-research.js": {
      "maxDuration": 60
    },
    "api/os2-intake.js": {
      "maxDuration": 60
    },
    "api/os2-ask.js": {
      "maxDuration": 60
    },
    "api/os2-run.js": {
      "maxDuration": 60
    },
    "api/os2-cron.js": {
      "maxDuration": 300
    },
    "api/os2-pulse.js": {
      "maxDuration": 60
    },
    "api/os2-digest.js": {
      "maxDuration": 120
    },
    "api/tmi-intel.js": {
      "maxDuration": 120
    },
    "api/tmi-proof.js": {
      "maxDuration": 120
    },
    "api/tmi-publish.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/ceo-agent",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/chief-of-staff",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/agents",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/visitor-digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/visitor-process",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/rep-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/campaign-send",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/os2-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/os2-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/os2-digest",
      "schedule": "0 13 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.tmitechai.com"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cityleads.tmitechai.com"
        }
      ],
      "destination": "/cityleads/index",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "os.tmitechai.com"
        }
      ],
      "destination": "/os/index",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pay",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/os2-oauth/:provider/:step",
      "destination": "/api/os2-oauth?provider=:provider&step=:step"
    },
    {
      "source": "/audit-report",
      "destination": "/api/audit-report"
    },
    {
      "source": "/audit/:slug([a-zA-Z0-9-]+)",
      "destination": "/api/audit-page?slug=:slug"
    },
    {
      "source": "/dashboard",
      "has": [
        {
          "type": "host",
          "value": "admin.tmitechai.com"
        }
      ],
