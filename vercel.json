{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/stratum",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "https://trades.tmitechai.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/coaches",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "/online-coaches"
    },
    {
      "source": "/courses",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "/online-courses"
    },
    {
      "source": "/creators",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "/online-creators"
    },
    {
      "source": "/info",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "/online-info"
    },
    {
      "source": "/ecom",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "/online-ecom"
    },
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "online.tmitechai.com"}],
      "destination": "/online"
    },
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "trades.tmitechai.com"}],
      "destination": "/stratum"
    }
  ]
}
