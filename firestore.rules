rules_version = '2';
// All data access is server-side via the Firebase Admin SDK (which bypasses
// these rules). Deny every direct client read/write — the browser never
// touches Firestore directly; it goes through the /api/* endpoints.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
